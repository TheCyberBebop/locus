# --- Project identity ---
PROJECT_NAME           = "locus"
PROJECT_BRIEF          = "Loader Of Compiled Universal Systems"
OUTPUT_DIRECTORY       = docs

# --- Inputs (repo layout) ---
INPUT                  = locus unit_tests/unit_tests.dox
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.dox

# Treat C constructs (typedefs, structs, etc.) more naturally.
OPTIMIZE_OUTPUT_FOR_C  = YES

# Prefer typedef names in documentation output.
TYPEDEF_HIDES_STRUCT   = YES

# --- Extraction policy ---
# Only document things that are actually documented with Doxygen comments.
EXTRACT_ALL            = NO

# Document "static" functions? Usually NO (keeps internal helpers out).
EXTRACT_STATIC         = NO

# Show "private" stuff? For C this mostly maps to undocumented/internal.
EXTRACT_PRIVATE        = NO

# --- Macros / preprocessor ---
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

# If your docs should reflect a specific log level, set it here.
# Example: PREDEFINED += LOG_LEVEL=LOG_LEVEL_DEBUG
PREDEFINED             =

# --- Warnings / correctness (useful for discipline) ---
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# --- Output formats ---
GENERATE_HTML          = YES
HTML_OUTPUT            = html

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

# --- Graphs (Graphviz) ---
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CALL_GRAPH             = YES
CALLER_GRAPH           = NO
UML_LOOK               = NO

# --- Cleanliness ---
QUIET                  = NO
JAVADOC_AUTOBRIEF      = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

# --- What to ignore ---
EXCLUDE_PATTERNS       = \
                         */build/* \
                         */artifacts/* \
                         */docs/*
